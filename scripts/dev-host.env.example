# 复制为同目录下的 dev-host.env 后填入开发机地址。
#   cp scripts/dev-host.env.example scripts/dev-host.env
# scripts/dev-host.env 已被 gitignore，不要把真实 IP 或密钥写进示例文件或提交进仓库。
#
# 也可以不用这个文件，改用：
#   --host user@ip
#   或 export AIVIDEO_DEV_HOST=user@ip
#   或 export DEV_HOST=user@ip
#
# 不要填生产机地址，除非你有意拉取生产数据。

# 必填：SSH 目标，建议写成 user@ip 或 user@hostname
AIVIDEO_DEV_HOST=ubuntu@x.x.x.x

# 可选
# DEV_SSH_PORT=22
# DEV_SSH_USER=ubuntu
# DEV_SSH_KEY=~/.ssh/id_ed25519

# 远端仓库根目录。与 deploy/deploy.sh 的默认 REMOTE_DIR 一致。
# AIVIDEO_DEV_REMOTE_DIR=/home/ubuntu/aivideo

# 若已确知 data 目录，可直接写死，跳过自动探测。
# 原生/绑定挂载一般是 /home/ubuntu/aivideo/data
# docker compose 默认把 named volume aivideo-data 挂到容器 /app/data
# AIVIDEO_DEV_REMOTE_DATA=/home/ubuntu/aivideo/data

# 若用现有 docker-compose 部署（data 在 named volume 里，不在仓库 data/ 下），设为 1。
# 读取 volume 可能需要远端免密 sudo。
# AIVIDEO_DEV_DOCKER=1
# AIVIDEO_DEV_DOCKER_CONTAINER=aivideo
# AIVIDEO_DEV_DOCKER_VOLUME=aivideo-data
