# DeepSeek 官方 API：https://platform.deepseek.com
# 网站写剧本走 deepseek_api，变量名是 DEEPSEEK_API_KEY。
DEEPSEEK_API_KEY=

# 可选。默认 https://api.deepseek.com
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# iCreat GPT Image 2：https://icreat.ai
# 出片生图走 icreat_api，变量名是 ICREAT_API_KEY。
ICREAT_API_KEY=
# 可选。默认竖屏 9:16 的 1440x2560、high。
# ICREAT_IMAGE_SIZE=1440x2560
# ICREAT_IMAGE_QUALITY=high

# 可选：监听地址。Docker 里用 0.0.0.0
# HOST=0.0.0.0
# PORT=8787

# Debug：写完剧本后只生图，不出视频、不拼接。页面也可单独勾选。
# AIVIDEO_DEBUG_LLM=1

# CR API 大模型：cr_api 从这里读取。https://api.creative-reasoning.com
# 网站写剧本仍走上面的 DEEPSEEK_API_KEY。
CR_API_KEY=
