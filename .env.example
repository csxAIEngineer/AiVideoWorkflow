# Qwen 读上传静帧：end/qwen_vision.py。没配密钥时不读图，素材说明里写「尚未读图」。
# 工作空间 Chat Completions 地址，例如 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
# 可选。默认 qwen3.8-omni-flash
# QWEN_VISION_MODEL=qwen3.8-omni-flash

# DeepSeek 官方 API：https://platform.deepseek.com
# 网站写剧本走 deepseek_api，变量名是 DEEPSEEK_API_KEY。
DEEPSEEK_API_KEY=

# 可选。默认 https://api.deepseek.com
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# iCreat GPT Image 2：https://icreat.ai
# 出片生图走 icreat_api，变量名是 ICREAT_API_KEY。
ICREAT_API_KEY=
# 可选。默认 1024x1024、high。
# ICREAT_IMAGE_SIZE=1024x1024
# ICREAT_IMAGE_QUALITY=high

# 可选：监听地址。Docker 里用 0.0.0.0
# HOST=0.0.0.0
# PORT=8787

# 仅 local 存储使用。COS 不走这台机器。
# AIVIDEO_PUBLIC_BASE=

# 图片存储。local 写到本机并用上面的基址拼地址。cos 用 HTTP PUT 上传到公有读写的腾讯云 COS。oss 尚未接入。
AIVIDEO_IMAGE_STORE=cos
# 存储桶名字，形如 example-1250000000
AIVIDEO_COS_BUCKET=
# 访问域名，不要末尾斜杠。PUT 和交给 CR 的地址都用它。
# 示例：https://example-1250000000.cos.ap-guangzhou.myqcloud.com
AIVIDEO_COS_DOMAIN=

# Debug：写完剧本后只生图，不出视频、不拼接。页面也可单独勾选。
# AIVIDEO_DEBUG_LLM=1

# CR API 大模型：cr_api 从这里读取。https://api.creative-reasoning.com
# 网站写剧本仍走上面的 DEEPSEEK_API_KEY。
CR_API_KEY=

# MiniMax 官方：旁白 speech-2.8-hd（POST /t2a_v2）。出片声轨只合成旁白，不生成背景音乐。
MINIMAX_API_KEY=
# 可选。默认 https://api.minimaxi.com/v1。国际站密钥改为 https://api.minimax.io/v1
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# 旁白音色。留空时客户端拉系统音色，取一条中文音色再写到这一行。
MINIMAX_VOICE_ID=Chinese (Mandarin)_Reliable_Executive
